{
  "version": 6,
  "cmakeMinimumRequired": { "major": 4, "minor": 2, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Visual Studio 18 2026",
      "architecture": { "value": "x64", "strategy": "set" },
      "toolset": { "value": "v145,cuda=C:/Program Files/NVIDIA GPU Computing Toolkit/CUDA/v13.1", "strategy": "set" },
      "binaryDir": "${sourceDir}/out/${presetName}",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "CMAKE_CUDA_ARCHITECTURES": "89;120",
        "CMAKE_CUDA_FLAGS": "-allow-unsupported-compiler"
      }
    },
    {
      "name": "x64-debug",
      "displayName": "x64 Debug",
      "inherits": "base",
      "cacheVariables": {
        "BYTRON_BUILD_TESTS": "ON",
        "BYTRON_BUILD_BENCHMARKS": "OFF"
      }
    },
    {
      "name": "x64-release",
      "displayName": "x64 Release",
      "inherits": "base",
      "cacheVariables": {
        "BYTRON_BUILD_TESTS": "ON",
        "BYTRON_BUILD_BENCHMARKS": "ON"
      }
    },
    {
      "name": "ci",
      "displayName": "Tests and benchmarks only (no GPU SDKs)",
      "architecture": { "value": "x64", "strategy": "set" },
      "binaryDir": "${sourceDir}/out/${presetName}",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "BYTRON_BUILD_APP": "OFF",
        "BYTRON_BUILD_TESTS": "ON",
        "BYTRON_BUILD_BENCHMARKS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "x64-debug",
      "configurePreset": "x64-debug",
      "configuration": "Debug"
    },
    {
      "name": "x64-release",
      "configurePreset": "x64-release",
      "configuration": "Release"
    },
    {
      "name": "x64-relwithdebinfo",
      "configurePreset": "x64-release",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "ci",
      "configurePreset": "ci",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "x64-debug",
      "configurePreset": "x64-debug",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "x64-release",
      "configurePreset": "x64-release",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "ci",
      "configurePreset": "ci",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    }
  ]
}
